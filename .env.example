TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=-1003700755579
ADMIN_TELEGRAM_ID=your_personal_telegram_id_here
OPENAI_API_KEY=your_openai_api_key_here
# Classify stays cheap; Hebrew summaries use mini.
# OPENAI_MODEL_CLASSIFY=gpt-5.4-nano
# OPENAI_MODEL_SUMMARIZE=gpt-5.4-mini
DB_PATH=/opt/polish_news/seen.db

# During the day, only stories at or above this score interrupt Telegram.
# Everything accepted by the classifier is retained for the daily brief.
NEWS_TELEGRAM_MIN_SCORE=40
NEWS_DIGEST_ENABLED=1
NEWS_DIGEST_MAX_ITEMS=8
NEWS_DIGEST_MODEL=gpt-5.4-mini

EMAIL_DIGEST_ENABLED=false
EMAIL_TO=tshprung@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set 0 to hide link preview cards (default 1: append raw URL so Telegram shows og:image preview).
# TELEGRAM_LINK_PREVIEW_ENABLED=1

# RSS items older than this (published time) are ignored (default 48).
# MAX_ARTICLE_AGE_HOURS=48
